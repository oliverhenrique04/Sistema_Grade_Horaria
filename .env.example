# Porta do servidor HTTP
PORT=3000

# Ambiente: development | test | production
NODE_ENV=production

# Conexao PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/grade_horaria
DB_SSL=false

# Schema do PostgreSQL utilizado pela aplicacao (padrao: public)
DB_SCHEMA=public

# Prefixo quando servido atras de proxy reverso (ex.: /grades). Vazio = raiz.
BASE_PATH=

# Endereco publico da aplicacao, so esquema e host (ex.: https://unieuro.edu.br).
# Serve ao QR do painel das TVs: a TV costuma alcancar o servidor por um endereco
# interno sem TLS, mas o celular do aluno precisa de um endereco que ele resolva.
# O caminho e ignorado — o prefixo continua vindo de BASE_PATH.
# Vazio = deriva tudo da requisicao (correto quando os dois enderecos coincidem).
URL_PUBLICA=

# Segredo de assinatura dos cookies de sessao.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Duracao da sessao em minutos (padrao 480 = 8h)
SESSION_TTL_MINUTOS=480

# Cookie seguro (HTTPS). Em producao mantenha true.
COOKIE_SECURE=true

# Credenciais do administrador criado pelo comando "npm run seed".
# Se ADMIN_SENHA ficar vazio, o seed gera uma senha aleatoria e a imprime uma unica vez.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.edu.br
ADMIN_SENHA=

# Tentativas de login permitidas por IP dentro da janela (padrao 10 em 15 min)
LOGIN_RATE_LIMIT=10
LOGIN_RATE_JANELA_MINUTOS=15
