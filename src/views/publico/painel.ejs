<%
    /*
     * Painel de corredor: a pagina que fica nas TVs de cada bloco.
     *
     * Tudo chega pronto do servico — faixa do dia, compactacao, situacao de
     * cada linha, paginacao e regime de densidade. Aqui nao se decide nada.
     *
     * Todas as paginas sao renderizadas de uma vez e alternadas por
     * `hidden` em painel.js. Buscar pagina por pagina exigiria manter estado
     * numa tela que fica meses ligada; render unico nao acumula nada.
     */
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= tituloPagina %></title>
    <link rel="stylesheet" href="<%= asset('/css/painel.css') %>">
</head>
<body>
    <div class="tv" id="tv" data-faixa="<%= vazio || configurar ? 'noite' : faixa.chave %>">
        <div class="ceu" aria-hidden="true">
            <div class="bruma"></div>
            <div class="raios"></div>
            <div class="astro"></div>
            <div class="estrelas"></div>
            <div class="estrelas lenta"></div>
            <div class="veu"></div>
        </div>

        <header class="cabecalho">
            <p class="cab-marca">Unieuro<%= periodo ? ' · ' + periodo.codigo : '' %></p>
            <h1 class="cab-titulo"><%= titulo || 'Aulas de hoje' %></h1>
            <p class="cab-data">
                <% if (!configurar && !vazio) { %>
                    <%= diaNome %><%= amanha ? ' (amanhã)' : ', ' + dataRotulo %>
                <% } else { %>
                    Painel de aulas
                <% } %>
            </p>

            <p class="cab-relogio">
                <b id="relogioHora">--:--</b><span id="relogioSegundos">:--</span>
            </p>

            <% if (!configurar && !vazio) { %>
                <p class="cab-faixa">
                    <%- include('partials/painel-icone', { icone: faixa.icone }) %>
                    <span class="cab-faixa-nome"><%= faixa.nome %></span>
                    <span class="cab-faixa-janela"><%= janela.inicio %> – <%= janela.fim %></span>
                </p>
            <% } %>
        </header>

        <main class="quadro"
              id="quadro"
              data-densidade="<%= configurar || vazio ? 'escassa' : densidade %>"
              role="region"
              aria-label="Aulas do turno"
              aria-live="off">
            <% if (configurar) { %>
                <div class="aviso">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                        <path d="M12 3.2 21 8v8l-9 4.8L3 16V8Z"/><path d="M12 12v8.8M3 8l9 4 9-4"/>
                    </svg>
                    <h2>Painel sem configuração</h2>
                    <% if (motivo === 'slug') { %>
                        <p>Este endereço não corresponde a nenhum painel ativo.</p>
                        <code>Painel administrativo · TVs dos blocos</code>
                    <% } else if (motivo === 'campus') { %>
                        <p>Falta escolher o campus no endereço desta tela.</p>
                        <code>?campus=…</code>
                    <% } else { %>
                        <p>Nenhum período letivo ativo cadastrado.</p>
                    <% } %>
                </div>
            <% } else if (vazio) { %>
                <div class="aviso">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                        <rect x="3" y="4.6" width="18" height="16" rx="2.4"/>
                        <path d="M3 9.4h18M8 2.6v3.6M16 2.6v3.6M9.4 14.6l5.2 3M14.6 14.6l-5.2 3"/>
                    </svg>
                    <h2>Sem aulas previstas</h2>
                    <p>Nenhuma aula publicada para este recorte no período <%= periodo.codigo %>.</p>
                </div>
            <% } else { %>
                <div class="colunas">
                    <span>Horário</span>
                    <span>Disciplina · turmas</span>
                    <span class="dir">Sala</span>
                </div>

                <% paginas.forEach(function (pagina, indice) { %>
                    <div class="pagina" data-pagina="<%= indice %>" <%= indice === 0 ? '' : 'hidden' %>>
                        <% pagina.forEach(function (linha) { %>
                            <%- include('partials/painel-linha', { linha: linha }) %>
                        <% }) %>
                    </div>
                <% }) %>
            <% } %>
        </main>

        <footer class="rodape">
            <%
                /* A marca fica no rodape, do lado oposto ao QR: presente, sem
                   competir com o quadro nem com o codigo, que e o unico
                   elemento acionavel da tela. */
            %>
            <p class="marca" role="img" aria-label="NUTED — Núcleo de Tecnologias Educacionais"></p>

            <% if (!configurar && !vazio) { %>
                <ul class="legenda">
                    <li class="l-agora"><i aria-hidden="true"></i> Em aula</li>
                    <li class="l-breve"><i aria-hidden="true"></i> Começa em breve</li>
                    <li class="l-fim"><i aria-hidden="true"></i> Encerrada</li>
                </ul>
            <% } %>

            <p class="rodape-estado">
                <% if (paginas.length > 1) { %>
                    <span id="indicadorPagina">página 1 de <%= paginas.length %></span>
                    <span class="barra" aria-hidden="true"><i></i></span>
                <% } %>
                <span id="estadoRede"></span>
            </p>

            <div class="qr">
                <p class="qr-texto"><b>Sua grade completa</b>aponte a câmera</p>
                <div class="qr-codigo"><%- qrSvg %></div>
            </div>
        </footer>
    </div>

    <script src="<%= asset('/js/painel.js') %>"
            data-paginas="<%= configurar || vazio ? 0 : paginas.length %>"
            defer></script>
</body>
</html>
