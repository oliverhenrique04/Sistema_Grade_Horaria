<%
    /*
     * Icone da faixa do dia. SVG inline porque a TV precisa desenhar sem uma
     * segunda requisicao — e porque uma fonte de icones por tres desenhos
     * custaria mais bytes do que a pagina inteira.
     */
%>
<% if (icone === 'sol') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" fill="currentColor" stroke="none" opacity=".9"/>
        <path d="M12 2.6v2.4M12 19v2.4M2.6 12h2.4M19 12h2.4M5.4 5.4l1.7 1.7M16.9 16.9l1.7 1.7M18.6 5.4l-1.7 1.7M7.1 16.9l-1.7 1.7"/>
    </svg>
<% } else if (icone === 'entardecer') { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="11" r="3.6" fill="currentColor" stroke="none" opacity=".9"/>
        <path d="M12 2.6v2.2M4.6 11H2.4M21.6 11h-2.2M6.1 5.1 4.6 3.6M17.9 5.1l1.5-1.5"/>
        <path d="M2.8 17.4h18.4M6 20.6h12"/>
    </svg>
<% } else { %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.4A8.4 8.4 0 1 1 9.6 4a6.6 6.6 0 0 0 10.4 10.4Z" fill="currentColor" opacity=".9" stroke="none"/>
        <path d="M20 14.4A8.4 8.4 0 1 1 9.6 4a6.6 6.6 0 0 0 10.4 10.4Z"/>
    </svg>
<% } %>
