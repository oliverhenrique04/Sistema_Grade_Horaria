<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Consulta pública da grade horária das turmas por campus, curso, semestre e turno.">
    <title><%= tituloPagina %></title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= asset('/css/publico.css') %>">
</head>
<body class="<%= modoImpressao ? 'modo-impressao' : '' %>">
    <a class="atalho-conteudo" href="#conteudo-principal">Pular para a grade horária</a>

    <div class="parallax" aria-hidden="true">
        <div class="layer l1"></div>
        <div class="layer l2"></div>
        <div class="layer l3"></div>
    </div>
    <div class="grain" aria-hidden="true"></div>

    <div class="wrap">
        <header class="hero glass">
            <div class="hero-top">
                <div class="hero-title">
                    <img src="<%= withBase('/logo_unieuro.png') %>" alt="Unieuro" class="hero-logo">
                    <div>
                        <h1>Grade Horária dos Cursos</h1>
                        <p class="subtitle">Consulte os horários das turmas por campus, curso, semestre e turno.</p>

                        <ul class="meta" aria-label="Recorte da consulta">
                            <li class="pill">
                                <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                                Período letivo:
                                <strong><%= filtrosAplicados.periodo ? filtrosAplicados.periodo.codigo : 'não definido' %></strong>
                            </li>
                            <% if (filtrosAplicados.campus) { %>
                                <li class="pill">
                                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                                    Campus: <strong><%= filtrosAplicados.campus.nome %></strong>
                                </li>
                            <% } %>
                            <% if (filtrosAplicados.curso) { %>
                                <li class="pill">
                                    <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                                    Curso: <strong><%= filtrosAplicados.curso.nome %></strong>
                                </li>
                                <% if (filtrosAplicados.curso.coordenador) { %>
                                    <li class="pill">
                                        <i class="fa-solid fa-user-tie" aria-hidden="true"></i>
                                        Coordenação: <strong><%= filtrosAplicados.curso.coordenador %></strong>
                                    </li>
                                <% } %>
                            <% } %>
                            <% if (filtrosAplicados.semestre) { %>
                                <li class="pill">
                                    <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                                    Semestre: <strong><%= filtrosAplicados.semestreRotulo %></strong>
                                </li>
                            <% } %>
                            <% if (filtrosAplicados.turno) { %>
                                <li class="pill">
                                    <i class="fa-solid <%= filtrosAplicados.turno.icone %>" aria-hidden="true"></i>
                                    Turno: <strong><%= filtrosAplicados.turno.nome %></strong>
                                </li>
                            <% } %>
                        </ul>
                    </div>
                </div>

                <% if (!modoImpressao) { %>
                    <div class="hero-acoes">
                        <a class="botao botao-secundario" href="<%= urlImpressao %>">
                            <i class="fa-solid fa-print" aria-hidden="true"></i> Versão para impressão
                        </a>
                    </div>
                <% } %>
            </div>

            <% if (!modoImpressao) { %>
                <%- include('partials/filtros') %>
            <% } %>
        </header>

        <main id="conteudo-principal" class="conteudo" tabindex="-1">
            <% if (precisaSelecionar) { %>
                <%- include('partials/orientacao') %>
            <% } else if (turmas.length === 0) { %>
                <%- include('partials/vazio') %>
            <% } else { %>
                <p class="resumo-consulta">
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    <%= totalAulas %> <%= totalAulas === 1 ? 'aula encontrada' : 'aulas encontradas' %>.
                </p>

                <% turmas.forEach(function (grupo) { %>
                    <section class="turno <%= grupo.turno.temaClass %>" aria-labelledby="turno-<%= grupo.turno.id %>">
                        <h2 class="turno-titulo" id="turno-<%= grupo.turno.id %>">
                            <i class="fa-solid <%= grupo.turno.icone %>" aria-hidden="true"></i>
                            <span>Turno <%= grupo.turno.nome %></span>
                        </h2>

                        <% grupo.turmas.forEach(function (turma) { %>
                            <%- include('partials/turma', { turma: turma }) %>
                        <% }) %>
                    </section>
                <% }) %>
            <% } %>
        </main>

        <footer class="rodape glass">
            <div class="rodape-marca">
                <img src="<%= withBase('/logo_nuted.png') %>" alt="NUTED" class="rodape-logo">
                <p class="rodape-titulo">
                    <i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>
                    Grade Horária · Unieuro
                </p>
            </div>
            <p class="rodape-aviso">
                Este material é informativo e pode sofrer ajustes conforme o calendário
                acadêmico e a alocação docente.
            </p>
            <p class="rodape-aviso">&copy; <%= anoAtual %> Unieuro</p>
        </footer>
    </div>

    <% if (!modoImpressao) { %>
        <script>
            // Progressive enhancement: sem JavaScript o formulario continua
            // funcionando pelo botao "Aplicar filtros".
            (function () {
                var formularios = document.querySelectorAll('form[data-submete-ao-mudar]');

                Array.prototype.forEach.call(formularios, function (formulario) {
                    var enviar = function () {
                        if (typeof formulario.requestSubmit === 'function') {
                            formulario.requestSubmit();
                            return;
                        }
                        formulario.submit();
                    };

                    Array.prototype.forEach.call(formulario.querySelectorAll('select'), function (campo) {
                        campo.addEventListener('change', enviar);
                    });
                });
            })();
        </script>
    <% } else { %>
        <script>
            window.addEventListener('load', function () {
                window.print();
            });
        </script>
    <% } %>
</body>
</html>
