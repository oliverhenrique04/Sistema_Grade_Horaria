<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title><%= tituloPagina %> · Painel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
</head>
<body>
    <a class="visually-hidden-focusable atalho-conteudo" href="#conteudo-principal">Pular para o conteúdo</a>

    <div class="painel">
        <%- include('../partials/menu-lateral') %>

        <div class="painel-conteudo">
            <%- include('../partials/barra-superior') %>

            <main id="conteudo-principal" class="painel-main" tabindex="-1">
                <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length > 0) { %>
                    <%- include('../partials/breadcrumbs', { breadcrumbs: breadcrumbs }) %>
                <% } %>

                <%- include('../partials/mensagens') %>
