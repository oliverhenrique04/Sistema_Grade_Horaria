<%- include('../../layouts/admin-inicio') %>

<%
/*
 * Lista de locais: filtros por campus, tipo e situacao, busca por nome/codigo e
 * indicacao de quantas aulas usam cada local.
 *
 * Para o perfil `nap` a consulta ja vem restrita aos campus vinculados a ele.
 */
const urlNovo = withBase('/admin/locais/novo' + (filtros.campus_id ? '?campus_id=' + filtros.campus_id : ''));
const temFiltro = Boolean(filtros.busca || filtros.campus_id || filtros.tipo || filtros.ativo !== '');
%>

<section class="painel-cartao" aria-labelledby="titulo-locais">
    <div class="painel-cartao-cabecalho">
        <div>
            <h2 class="h6 mb-1" id="titulo-locais">Locais</h2>
            <p class="painel-indicador-nota mb-0">
                Locais já usados em aulas só podem ser inativados.
            </p>
        </div>

        <% if (podeVer('locais', 'criar') && campus.length > 0) { %>
            <a class="btn btn-primary btn-sm" href="<%= urlNovo %>">
                <i class="fa-solid fa-plus" aria-hidden="true"></i> Novo local
            </a>
        <% } %>
    </div>

    <form method="GET" action="<%= withBase('/admin/locais') %>" class="painel-filtros" role="search">
        <div class="painel-filtros-campo">
            <label class="form-label" for="filtro-campus">Campus</label>
            <select class="form-select form-select-sm" id="filtro-campus" name="campus_id"
                    data-submete-ao-mudar>
                <option value="">Todos os campus</option>
                <% campus.forEach((unidade) => { %>
                    <option value="<%= unidade.id %>" <%= filtros.campus_id === String(unidade.id) ? 'selected' : '' %>>
                        <%= unidade.nome %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="painel-filtros-campo">
            <label class="form-label" for="filtro-tipo">Tipo</label>
            <select class="form-select form-select-sm" id="filtro-tipo" name="tipo"
                    data-submete-ao-mudar>
                <option value="">Todos os tipos</option>
                <% tipos.forEach((tipo) => { %>
                    <option value="<%= tipo.valor %>" <%= filtros.tipo === tipo.valor ? 'selected' : '' %>>
                        <%= tipo.rotulo %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="painel-filtros-campo">
            <label class="form-label" for="filtro-busca">Buscar</label>
            <input type="search" class="form-control form-control-sm" id="filtro-busca"
                   name="busca" value="<%= filtros.busca %>" placeholder="Nome ou código"
                   maxlength="120">
        </div>

        <div class="painel-filtros-campo">
            <label class="form-label" for="filtro-situacao">Situação</label>
            <select class="form-select form-select-sm" id="filtro-situacao" name="ativo"
                    data-submete-ao-mudar>
                <option value="" <%= filtros.ativo === '' ? 'selected' : '' %>>Todos</option>
                <option value="1" <%= filtros.ativo === '1' ? 'selected' : '' %>>Ativos</option>
                <option value="0" <%= filtros.ativo === '0' ? 'selected' : '' %>>Inativos</option>
            </select>
        </div>

        <div class="painel-filtros-campo">
            <label class="form-label" for="filtro-por-pagina">Por página</label>
            <select class="form-select form-select-sm" id="filtro-por-pagina" name="por_pagina"
                    data-submete-ao-mudar>
                <% paginacao.tamanhos.forEach((tamanho) => { %>
                    <option value="<%= tamanho %>" <%= paginacao.porPagina === tamanho ? 'selected' : '' %>>
                        <%= tamanho %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div>
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Filtrar
            </button>
            <a class="btn btn-sm btn-link" href="<%= withBase('/admin/locais') %>">Limpar</a>
        </div>
    </form>

    <% if (campus.length === 0) { %>
        <%- include('../../partials/estado-vazio', {
            icone: 'fa-building-columns',
            titulo: 'Nenhum campus disponível',
            descricao: 'Locais pertencem a um campus. Peça a um administrador que vincule você a um campus ou cadastre um campus antes.',
            acaoUrl: null,
            acaoTexto: ''
        }) %>
    <% } else if (itens.length === 0) { %>
        <%- include('../../partials/estado-vazio', {
            icone: 'fa-door-open',
            titulo: 'Nenhum local encontrado',
            descricao: temFiltro
                ? 'Nenhum local corresponde aos filtros aplicados.'
                : 'Cadastre a primeira sala ou ambiente.',
            acaoUrl: podeVer('locais', 'criar') ? urlNovo : null,
            acaoTexto: 'Novo local'
        }) %>
    <% } else { %>
        <div class="table-responsive">
            <table class="table painel-tabela align-middle">
                <thead>
                    <tr>
                        <th scope="col">Local</th>
                        <th scope="col">Campus</th>
                        <th scope="col">Tipo</th>
                        <th scope="col" class="text-end">Capacidade</th>
                        <th scope="col" class="text-end">Aulas</th>
                        <th scope="col">Situação</th>
                        <th scope="col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    <% itens.forEach((item) => { %>
                        <tr>
                            <th scope="row" class="fw-semibold">
                                <%= item.nome %>
                                <% if (item.codigo) { %>
                                    <span class="painel-indicador-nota">· <%= item.codigo %></span>
                                <% } %>
                            </th>
                            <td><%= item.campus_nome %></td>
                            <td><%= formatadores.tipoLocalRotulo(item.tipo) %></td>
                            <td class="text-end">
                                <%= item.capacidade === null ? '—' : item.capacidade %>
                            </td>
                            <td class="text-end"><%= item.total_aulas %></td>
                            <td><%- include('../../partials/status-badge', { ativo: item.ativo }) %></td>
                            <td>
                                <div class="painel-tabela-acoes">
                                    <% if (podeVer('locais', 'editar')) { %>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="<%= withBase('/admin/locais/' + item.id + '/editar') %>">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                            <span class="visually-hidden">Editar <%= item.nome %></span>
                                        </a>
                                    <% } %>

                                    <% if (podeVer('locais', 'inativar')) { %>
                                        <form method="POST"
                                              action="<%= withBase('/admin/locais/' + item.id + '/situacao') %>"
                                              data-confirmar="<%= item.ativo ? 'Inativar o local ' + item.nome + '?' : 'Reativar o local ' + item.nome + '?' %>">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="ativo" value="<%= item.ativo ? '0' : '1' %>">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                <i class="fa-solid <%= item.ativo ? 'fa-toggle-off' : 'fa-toggle-on' %>" aria-hidden="true"></i>
                                                <span class="visually-hidden">
                                                    <%= item.ativo ? 'Inativar' : 'Reativar' %> <%= item.nome %>
                                                </span>
                                            </button>
                                        </form>

                                        <% if (item.total_aulas === 0) { %>
                                            <form method="POST"
                                                  action="<%= withBase('/admin/locais/' + item.id + '/excluir') %>"
                                                  data-confirmar="Excluir definitivamente o local <%= item.nome %>?">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Excluir <%= item.nome %></span>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <span class="badge text-bg-light border align-self-center"
                                                  title="Local usado em aulas: só pode ser inativado.">
                                                <i class="fa-solid fa-lock" aria-hidden="true"></i>
                                                em uso
                                            </span>
                                        <% } %>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <%- include('../../partials/paginacao', { paginacao: paginacao, urlBase: urlBase }) %>
    <% } %>
</section>

<%- include('../../layouts/admin-fim') %>
