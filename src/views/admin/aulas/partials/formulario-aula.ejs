<%
/*
 * Formulario de criacao/edicao de aula do montador.
 *
 * Funciona inteiramente sem JavaScript: e um POST comum e os botoes extras usam
 * `formaction` (recurso nativo do HTML) para enviar o MESMO formulario para
 * `/admin/aulas/lote` (varios periodos) ou `/admin/aulas/prever` (verificacao de
 * conflitos, sem gravar). Com JavaScript, a verificacao vira uma chamada em
 * segundo plano e a selecao de periodos consecutivos ganha atalhos.
 *
 * Espera: turma, horarios, dias, opcoes, modalidades, acao, aulaSelecionada,
 * valores, erros, somenteAlocacao e voltar.
 */
const edicao = acao === 'editar';
const acaoForm = edicao
    ? withBase('/admin/aulas/' + valores.aula_id)
    : withBase('/admin/aulas');

const igual = (a, b) => String(a === null || a === undefined ? '' : a) === String(b === null || b === undefined ? '' : b);
const marcadoHorario = (id) => (valores.horarios || []).some((valor) => Number(valor) === Number(id));

const tituloForm = edicao ? 'Editar aula' : 'Nova aula';
%>

<section class="painel-cartao montador-formulario" id="formulario-aula" aria-labelledby="titulo-formulario-aula" tabindex="-1">
    <div class="painel-cartao-cabecalho">
        <div>
            <h2 class="h6 mb-1" id="titulo-formulario-aula"><%= tituloForm %></h2>
            <p class="painel-indicador-nota mb-0">
                <% if (somenteAlocacao) { %>
                    Seu perfil ajusta apenas o local e a modalidade desta aula.
                <% } else { %>
                    Turma <%= turma.nome %> · <%= turma.turno_nome %> · <%= turma.periodo_codigo %>
                <% } %>
            </p>
        </div>

        <a class="btn btn-sm btn-outline-secondary" href="<%= urlBaseMontador %>">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i> Fechar
        </a>
    </div>

    <form method="POST" action="<%= acaoForm %>" class="montador-formulario-campos" id="form-aula">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="turma_id" value="<%= turma.id %>">
        <input type="hidden" name="voltar" value="<%= voltar %>">
        <% if (edicao) { %>
            <input type="hidden" name="aula_id" value="<%= valores.aula_id %>">
        <% } %>

        <% if (somenteAlocacao && aulaSelecionada) { %>
            <%
            /* Perfil NAP: os demais campos nao sao enviados. A restricao real
               esta no backend (o controller monta os campos permitidos um a um);
               aqui apenas nao ha o que preencher. */
            %>
            <dl class="montador-resumo">
                <div>
                    <dt>Disciplina</dt>
                    <dd><%= aulaSelecionada.disciplina_nome %></dd>
                </div>
                <div>
                    <dt>Professor</dt>
                    <dd><%= aulaSelecionada.professor_nome || 'Sem professor definido' %></dd>
                </div>
                <div>
                    <dt>Dia e horário</dt>
                    <dd>
                        <%= dias.filter((dia) => dia.valor === aulaSelecionada.dia_semana).map((dia) => dia.nome).join('') || 'Sem dia definido' %>
                        <% if (aulaSelecionada.horario_nome) { %>
                            · <%= aulaSelecionada.horario_nome %>
                            (<%= formatadores.faixaHoraria(aulaSelecionada.hora_inicio, aulaSelecionada.hora_fim) %>)
                        <% } else { %>
                            · sem horário definido
                        <% } %>
                    </dd>
                </div>
            </dl>
        <% } else { %>
            <div class="montador-formulario-linha">
                <div class="montador-campo">
                    <label class="form-label" for="campo-dia">Dia da semana</label>
                    <select class="form-select" id="campo-dia" name="dia_semana" required
                            <%- erros.diaSemana ? 'aria-describedby="erro-diaSemana" aria-invalid="true"' : '' %>>
                        <option value="">Selecione…</option>
                        <% dias.forEach((dia) => { %>
                            <option value="<%= dia.valor %>" <%= igual(valores.dia_semana, dia.valor) ? 'selected' : '' %>>
                                <%= dia.nome %>
                            </option>
                        <% }) %>
                    </select>
                    <%- include('../../../partials/campo-erro', { erros: erros, campo: 'diaSemana' }) %>
                </div>

                <div class="montador-campo">
                    <label class="form-label" for="campo-horario">Horário</label>
                    <select class="form-select" id="campo-horario" name="horario_turno_id"
                            aria-describedby="ajuda-horario">
                        <option value="">Sem horário definido (fica como pendência)</option>
                        <% horarios.forEach((horario) => { %>
                            <option value="<%= horario.id %>" <%= igual(valores.horario_turno_id, horario.id) ? 'selected' : '' %>>
                                <%= horario.nome %> — <%= horario.faixa %>
                            </option>
                        <% }) %>
                    </select>
                    <p class="form-text mb-0" id="ajuda-horario">Horários do turno <%= turma.turno_nome %>.</p>
                    <%- include('../../../partials/campo-erro', { erros: erros, campo: 'horarioTurnoId' }) %>
                </div>

                <div class="montador-campo montador-campo-largo">
                    <label class="form-label" for="campo-disciplina">Disciplina</label>
                    <select class="form-select" id="campo-disciplina" name="disciplina_id" required>
                        <option value="">Selecione…</option>
                        <% opcoes.disciplinas.forEach((disciplina) => { %>
                            <option value="<%= disciplina.id %>" <%= igual(valores.disciplina_id, disciplina.id) ? 'selected' : '' %>>
                                <%= disciplina.nome %><%= disciplina.codigo ? ' (' + disciplina.codigo + ')' : '' %><%= disciplina.ativo === false ? ' — inativa' : '' %>
                            </option>
                        <% }) %>
                    </select>
                    <%- include('../../../partials/campo-erro', { erros: erros, campo: 'disciplinaId' }) %>
                </div>

                <div class="montador-campo montador-campo-largo">
                    <label class="form-label" for="campo-professor">Professor</label>
                    <select class="form-select" id="campo-professor" name="professor_id">
                        <option value="">Sem professor definido</option>
                        <% opcoes.professores.forEach((professor) => { %>
                            <option value="<%= professor.id %>" <%= igual(valores.professor_id, professor.id) ? 'selected' : '' %>>
                                <%= professor.nome %><%= professor.ativo === false ? ' — inativo' : '' %>
                            </option>
                        <% }) %>
                    </select>
                    <%- include('../../../partials/campo-erro', { erros: erros, campo: 'professorId' }) %>
                </div>
            </div>
        <% } %>

        <div class="montador-formulario-linha">
            <div class="montador-campo montador-campo-largo">
                <label class="form-label" for="campo-local">Local</label>
                <select class="form-select" id="campo-local" name="local_id" data-buscavel="locais">
                    <option value="">Sem local definido</option>
                    <% opcoes.locais.forEach((local) => { %>
                        <option value="<%= local.id %>" <%= igual(valores.local_id, local.id) ? 'selected' : '' %>>
                            <%= formatadores.tipoLocalRotulo(local.tipo) %> <%= local.nome %><%= local.ativo === false ? ' — inativo' : '' %>
                        </option>
                    <% }) %>
                </select>
                <%- include('../../../partials/campo-erro', { erros: erros, campo: 'localId' }) %>
            </div>

            <div class="montador-campo">
                <label class="form-label" for="campo-modalidade">Modalidade</label>
                <select class="form-select" id="campo-modalidade" name="modalidade">
                    <% modalidades.forEach((item) => { %>
                        <option value="<%= item.valor %>" <%= igual(valores.modalidade, item.valor) ? 'selected' : '' %>>
                            <%= item.rotulo %>
                        </option>
                    <% }) %>
                </select>
                <%- include('../../../partials/campo-erro', { erros: erros, campo: 'modalidade' }) %>
            </div>

            <% if (!somenteAlocacao) { %>
                <div class="montador-campo montador-campo-largo">
                    <label class="form-label" for="campo-observacao">Observação</label>
                    <input type="text" class="form-control" id="campo-observacao" name="observacao"
                           maxlength="255" value="<%= valores.observacao %>"
                           placeholder="Opcional — ex.: aula prática">
                    <%- include('../../../partials/campo-erro', { erros: erros, campo: 'observacao' }) %>
                </div>
            <% } %>
        </div>

        <%
        /*
         * Turmas que cursam esta aula.
         *
         * No ensalamento do TOTVS, a turma gerencial registra a disciplina uma
         * unica vez e ela vale para varias turmas regulares, quase sempre de
         * semestres diferentes. Sem escolher aqui, a aula ficaria so na
         * gerencial e nao apareceria na grade de ninguem.
         */
        const candidatas = (opcoes.turmasAtendidas || []).filter((item) => item.ativo !== false);
        const marcadas = (valores.turmas_atendidas || []).map(Number);
        const marcada = (id) => marcadas.some((valor) => valor === Number(id));
        %>

        <% if (turma.gerencial && !somenteAlocacao && candidatas.length > 0) { %>
            <fieldset class="montador-atendidas-campo">
                <legend class="form-label">Turmas que cursam esta disciplina</legend>
                <p class="form-text mt-0" id="ajuda-atendidas">
                    A aula fica registrada uma única vez nesta turma gerencial e aparece na grade
                    de cada turma marcada, com o semestre dela. Sem nenhuma marcada, a disciplina
                    fica visível apenas aqui.
                </p>

                <!-- Marcador: distingue "nenhuma turma marcada" de "campo não enviado". -->
                <input type="hidden" name="turmas_atendidas_enviado" value="1">

                <div class="montador-atendidas-opcoes" aria-describedby="ajuda-atendidas">
                    <% candidatas.forEach((item) => { %>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   id="atende-<%= item.id %>" name="turmas_atendidas"
                                   value="<%= item.id %>" <%= marcada(item.id) ? 'checked' : '' %>>
                            <label class="form-check-label" for="atende-<%= item.id %>">
                                <span class="fw-semibold"><%= item.codigo || item.nome %></span>
                                <span class="text-body-secondary">
                                    <%= item.semestre ? formatadores.ordinal(item.semestre) + ' semestre' : 'sem semestre' %>
                                </span>
                            </label>
                        </div>
                    <% }) %>
                </div>

                <%- include('../../../partials/campo-erro', { erros: erros, campo: 'turmasAtendidas' }) %>
            </fieldset>
        <% } %>

        <% if (!edicao && !somenteAlocacao) { %>
            <fieldset class="montador-periodos" id="periodos-consecutivos">
                <legend class="form-label">Períodos consecutivos</legend>
                <p class="form-text mt-0" id="ajuda-periodos">
                    Marque os períodos em que esta mesma aula deve ser criada e use
                    “Criar nos períodos marcados”. Tudo é gravado de uma vez: se um
                    período conflitar, nenhum é criado.
                </p>

                <div class="montador-periodos-lista" aria-describedby="ajuda-periodos">
                    <% horarios.forEach((horario) => { %>
                        <div class="form-check montador-periodo">
                            <input class="form-check-input" type="checkbox"
                                   name="horario_turno_ids" value="<%= horario.id %>"
                                   id="periodo-<%= horario.id %>"
                                   data-periodo
                                   <%= marcadoHorario(horario.id) ? 'checked' : '' %>>
                            <label class="form-check-label" for="periodo-<%= horario.id %>">
                                <%= horario.nome %>
                                <span class="text-body-secondary"><%= horario.faixa %></span>
                            </label>
                        </div>
                    <% }) %>
                </div>
            </fieldset>
        <% } %>

        <div class="montador-formulario-acoes">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                <%= edicao ? 'Salvar alterações' : 'Salvar aula' %>
            </button>

            <% if (!edicao && !somenteAlocacao) { %>
                <button type="submit" class="btn btn-outline-primary"
                        formaction="<%= withBase('/admin/aulas/lote') %>">
                    <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
                    Criar nos períodos marcados
                </button>
            <% } %>

            <button type="submit" class="btn btn-outline-secondary" formnovalidate
                    formaction="<%= withBase('/admin/aulas/prever') %>"
                    data-prever="<%= withBase('/admin/aulas/prever') %>">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                Verificar conflitos
            </button>

            <a class="btn btn-link" href="<%= urlBaseMontador %>">Cancelar</a>
        </div>
    </form>
</section>
