<%- include('../../layouts/admin-inicio') %>

<%
/*
 * Formulario de horario do turno.
 *
 * O campo de término é sugerido pelo navegador (public/js/horarios.js), mas a
 * regra dos 50 minutos continua sendo validada no servidor e no banco.
 */
%>

<section class="painel-cartao" aria-labelledby="titulo-formulario-horario">
    <div class="painel-cartao-cabecalho">
        <h2 class="h6 mb-0" id="titulo-formulario-horario">
            <%= edicao ? 'Editar horário' : 'Novo horário' %>
        </h2>
    </div>

    <% if (mensagemErro) { %>
        <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>
            <%= mensagemErro %>
        </div>
    <% } %>

    <% if (edicao && emUso) { %>
        <div class="alert alert-warning" role="status">
            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
            Este horário já é usado em aulas da grade. Ele pode ser inativado, mas não excluído.
        </div>
    <% } %>

    <form method="POST" action="<%= acao %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3">
            <div class="col-12 col-lg-5">
                <label class="form-label" for="campo-turno">Turno <span aria-hidden="true">*</span></label>
                <select class="form-select <%= erros.turno_id ? 'is-invalid' : '' %>"
                        id="campo-turno" name="turno_id" required
                        <%= erros.turno_id ? 'aria-describedby="erro-turno_id" aria-invalid="true"' : '' %>>
                    <option value="">Selecione o turno</option>
                    <% turnos.forEach((turno) => { %>
                        <option value="<%= turno.id %>" <%= valores.turno_id === String(turno.id) ? 'selected' : '' %>>
                            <%= turno.nome %><%= turno.ativo ? '' : ' (inativo)' %>
                        </option>
                    <% }) %>
                </select>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'turno_id' }) %>
            </div>

            <div class="col-12 col-lg-5">
                <label class="form-label" for="campo-nome">Nome <span aria-hidden="true">*</span></label>
                <input type="text" class="form-control <%= erros.nome ? 'is-invalid' : '' %>"
                       id="campo-nome" name="nome" value="<%= valores.nome %>" maxlength="60" required
                       placeholder="1º horário"
                       <%= erros.nome ? 'aria-describedby="erro-nome" aria-invalid="true"' : '' %>>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'nome' }) %>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label" for="campo-ordem">Ordem <span aria-hidden="true">*</span></label>
                <input type="number" class="form-control <%= erros.ordem ? 'is-invalid' : '' %>"
                       id="campo-ordem" name="ordem" value="<%= valores.ordem %>" min="1" max="99" required
                       <%= erros.ordem ? 'aria-describedby="erro-ordem" aria-invalid="true"' : '' %>>
                <div class="form-text">Única no turno.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'ordem' }) %>
            </div>

            <div class="col-6 col-lg-3">
                <label class="form-label" for="campo-hora-inicio">
                    Início <span aria-hidden="true">*</span>
                </label>
                <input type="time" class="form-control <%= erros.hora_inicio ? 'is-invalid' : '' %>"
                       id="campo-hora-inicio" name="hora_inicio" value="<%= valores.hora_inicio %>" required
                       data-duracao-minutos="<%= duracaoMinutos %>"
                       <%= erros.hora_inicio ? 'aria-describedby="erro-hora_inicio" aria-invalid="true"' : '' %>>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'hora_inicio' }) %>
            </div>

            <div class="col-6 col-lg-3">
                <label class="form-label" for="campo-hora-fim">
                    Término <span aria-hidden="true">*</span>
                </label>
                <input type="time" class="form-control <%= erros.hora_fim ? 'is-invalid' : '' %>"
                       id="campo-hora-fim" name="hora_fim" value="<%= valores.hora_fim %>" required
                       <%= erros.hora_fim ? 'aria-describedby="erro-hora_fim" aria-invalid="true"' : '' %>>
                <div class="form-text">
                    Sempre <%= duracaoMinutos %> minutos após o início<%= horaFimSugerida ? ' (' + horaFimSugerida + ')' : '' %>.
                </div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'hora_fim' }) %>
            </div>

            <div class="col-6 col-lg-3">
                <label class="form-label" for="campo-ativo">Situação</label>
                <select class="form-select" id="campo-ativo" name="ativo">
                    <option value="1" <%= valores.ativo ? 'selected' : '' %>>Ativo</option>
                    <option value="0" <%= valores.ativo ? '' : 'selected' %>>Inativo</option>
                </select>
                <div class="form-text">Apenas horários ativos são verificados quanto à sobreposição.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'ativo' }) %>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                <%= edicao ? 'Salvar alterações' : 'Cadastrar horário' %>
            </button>
            <a class="btn btn-outline-secondary" href="<%= voltarUrl %>">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../../layouts/admin-fim') %>
