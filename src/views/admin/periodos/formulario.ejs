<%- include('../../layouts/admin-inicio') %>

<%
/*
 * Formulario de periodo letivo (criacao e edicao). Recebe do controller: modo,
 * periodo, valores, erros, acaoFormulario e urlCancelar.
 */
const edicao = modo === 'edicao';
%>

<div class="painel-cartao">
    <form method="POST" action="<%= acaoFormulario %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label" for="codigo">Código <span class="text-danger" aria-hidden="true">*</span></label>
                <input type="text" class="form-control <%= erros.codigo ? 'is-invalid' : '' %>"
                       id="codigo" name="codigo" value="<%= valores.codigo %>" maxlength="20"
                       placeholder="2026.1" required>
                <div class="form-text">No formato <strong>ano.semestre</strong>; ano e semestre são preenchidos automaticamente.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'codigo' }) %>
            </div>

            <div class="col-md-4">
                <label class="form-label" for="ano">Ano</label>
                <input type="number" class="form-control <%= erros.ano ? 'is-invalid' : '' %>"
                       id="ano" name="ano" value="<%= valores.ano %>" min="2000" max="2100" step="1">
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'ano' }) %>
            </div>

            <div class="col-md-4">
                <label class="form-label" for="semestre">Semestre</label>
                <input type="number" class="form-control <%= erros.semestre ? 'is-invalid' : '' %>"
                       id="semestre" name="semestre" value="<%= valores.semestre %>" min="1" max="4" step="1">
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'semestre' }) %>
            </div>

            <div class="col-md-4">
                <label class="form-label" for="dataInicio">Início das aulas</label>
                <input type="date" class="form-control <%= erros.dataInicio ? 'is-invalid' : '' %>"
                       id="dataInicio" name="dataInicio" value="<%= valores.dataInicio %>">
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'dataInicio' }) %>
            </div>

            <div class="col-md-4">
                <label class="form-label" for="dataFim">Término das aulas</label>
                <input type="date" class="form-control <%= erros.dataFim ? 'is-invalid' : '' %>"
                       id="dataFim" name="dataFim" value="<%= valores.dataFim %>">
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'dataFim' }) %>
            </div>

            <div class="col-md-4 d-flex align-items-center">
                <div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="ativo" name="ativo" value="1" <%= valores.ativo ? 'checked' : '' %>>
                        <label class="form-check-label" for="ativo">Período ativo</label>
                    </div>
                    <%- include('../../partials/campo-erro', { erros: erros, campo: 'ativo' }) %>

                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" role="switch"
                               id="atual" name="atual" value="1" <%= valores.atual ? 'checked' : '' %>>
                        <label class="form-check-label" for="atual">Período atual do sistema</label>
                    </div>
                    <div class="form-text">Ao marcar, o período atual anterior é desmarcado automaticamente.</div>
                    <%- include('../../partials/campo-erro', { erros: erros, campo: 'atual' }) %>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                <%= edicao ? 'Salvar alterações' : 'Cadastrar período' %>
            </button>
            <a href="<%= urlCancelar %>" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

<% if (edicao) { %>
    <div class="painel-cartao">
        <h2 class="h6">Informações do cadastro</h2>
        <dl class="row mb-0 small">
            <dt class="col-sm-3">Turmas vinculadas</dt>
            <dd class="col-sm-9"><%= periodo.total_turmas %> (<%= periodo.turmas_ativas %> ativa<%= periodo.turmas_ativas === 1 ? '' : 's' %>)</dd>

            <dt class="col-sm-3">Criado em</dt>
            <dd class="col-sm-9"><%= formatadores.dataBr(periodo.criado_em) %></dd>

            <dt class="col-sm-3">Última alteração</dt>
            <dd class="col-sm-9"><%= formatadores.dataBr(periodo.atualizado_em) %></dd>
        </dl>
    </div>
<% } %>

<%- include('../../layouts/admin-fim') %>
