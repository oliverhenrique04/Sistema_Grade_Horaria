<%- include('../../layouts/admin-inicio') %>

<%
/*
 * Formulario de turno (criacao e edicao).
 * O identificador (slug) e derivado do nome quando deixado em branco.
 */
%>

<section class="painel-cartao" aria-labelledby="titulo-formulario-turno">
    <div class="painel-cartao-cabecalho">
        <h2 class="h6 mb-0" id="titulo-formulario-turno">
            <%= edicao ? 'Editar turno' : 'Novo turno' %>
        </h2>
    </div>

    <% if (mensagemErro) { %>
        <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>
            <%= mensagemErro %>
        </div>
    <% } %>

    <form method="POST" action="<%= acao %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <label class="form-label" for="campo-nome">Nome <span aria-hidden="true">*</span></label>
                <input type="text" class="form-control <%= erros.nome ? 'is-invalid' : '' %>"
                       id="campo-nome" name="nome" value="<%= valores.nome %>" maxlength="60" required
                       <%= erros.nome ? 'aria-describedby="erro-nome" aria-invalid="true"' : '' %>>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'nome' }) %>
            </div>

            <div class="col-12 col-lg-6">
                <label class="form-label" for="campo-slug">Identificador</label>
                <input type="text" class="form-control <%= erros.slug ? 'is-invalid' : '' %>"
                       id="campo-slug" name="slug" value="<%= valores.slug %>" maxlength="60"
                       pattern="[a-z0-9]+(-[a-z0-9]+)*"
                       <%= erros.slug ? 'aria-describedby="erro-slug" aria-invalid="true"' : '' %>>
                <div class="form-text">
                    Deixe em branco para gerar a partir do nome<%= slugSugerido ? ' (' + slugSugerido + ')' : '' %>.
                    Apenas letras minúsculas, números e hífens.
                </div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'slug' }) %>
            </div>

            <div class="col-12 col-lg-4">
                <label class="form-label" for="campo-icone">Ícone</label>
                <input type="text" class="form-control <%= erros.icone ? 'is-invalid' : '' %>"
                       id="campo-icone" name="icone" value="<%= valores.icone %>" maxlength="50"
                       placeholder="fa-clock"
                       <%= erros.icone ? 'aria-describedby="erro-icone" aria-invalid="true"' : '' %>>
                <div class="form-text">Classe FontAwesome. Ex.: fa-sun, fa-moon.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'icone' }) %>
            </div>

            <div class="col-12 col-lg-4">
                <label class="form-label" for="campo-tema">Classe de tema</label>
                <input type="text" class="form-control <%= erros.tema_class ? 'is-invalid' : '' %>"
                       id="campo-tema" name="tema_class" value="<%= valores.tema_class %>" maxlength="50"
                       placeholder="matutino-theme"
                       <%= erros.tema_class ? 'aria-describedby="erro-tema_class" aria-invalid="true"' : '' %>>
                <div class="form-text">Opcional, usada na área pública.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'tema_class' }) %>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label" for="campo-ordem">Ordem</label>
                <input type="number" class="form-control <%= erros.ordem ? 'is-invalid' : '' %>"
                       id="campo-ordem" name="ordem" value="<%= valores.ordem %>" min="0" max="999"
                       <%= erros.ordem ? 'aria-describedby="erro-ordem" aria-invalid="true"' : '' %>>
                <div class="form-text">Exibição.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'ordem' }) %>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label" for="campo-ativo">Situação</label>
                <select class="form-select" id="campo-ativo" name="ativo">
                    <option value="1" <%= valores.ativo ? 'selected' : '' %>>Ativo</option>
                    <option value="0" <%= valores.ativo ? '' : 'selected' %>>Inativo</option>
                </select>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'ativo' }) %>
            </div>
        </div>

        <% if (edicao) { %>
            <p class="painel-indicador-nota mt-3 mb-0">
                <%= registro.total_horarios %> horário(s) cadastrado(s) e
                <%= registro.total_turmas %> turma(s) neste turno.
                <% if (podeVer('horarios')) { %>
                    <a href="<%= withBase('/admin/horarios?turno_id=' + registro.id) %>">
                        Gerenciar horários
                    </a>
                <% } %>
            </p>
        <% } %>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                <%= edicao ? 'Salvar alterações' : 'Cadastrar turno' %>
            </button>
            <a class="btn btn-outline-secondary" href="<%= voltarUrl %>">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../../layouts/admin-fim') %>
