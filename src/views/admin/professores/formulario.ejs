<%- include('../../layouts/admin-inicio') %>

<%
/*
 * Formulario de professor (criacao e edicao). Recebe do controller: modo,
 * professor, valores, erros, acaoFormulario e urlCancelar.
 */
const edicao = modo === 'edicao';
%>

<div class="painel-cartao">
    <form method="POST" action="<%= acaoFormulario %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="nome">Nome <span class="text-danger" aria-hidden="true">*</span></label>
                <input type="text" class="form-control <%= erros.nome ? 'is-invalid' : '' %>"
                       id="nome" name="nome" value="<%= valores.nome %>" maxlength="150" required>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'nome' }) %>
            </div>

            <div class="col-md-6">
                <label class="form-label" for="email">E-mail</label>
                <input type="email" class="form-control <%= erros.email ? 'is-invalid' : '' %>"
                       id="email" name="email" value="<%= valores.email %>" maxlength="150">
                <div class="form-text">Opcional, mas único no sistema.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'email' }) %>
            </div>

            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="ativo" name="ativo" value="1" <%= valores.ativo ? 'checked' : '' %>>
                    <label class="form-check-label" for="ativo">Professor ativo</label>
                </div>
                <div class="form-text">Professores inativos não podem receber novas aulas.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'ativo' }) %>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                <%= edicao ? 'Salvar alterações' : 'Cadastrar professor' %>
            </button>
            <a href="<%= urlCancelar %>" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>

<% if (edicao) { %>
    <div class="painel-cartao">
        <h2 class="h6">Informações do cadastro</h2>
        <dl class="row mb-0 small">
            <dt class="col-sm-3">Aulas atribuídas</dt>
            <dd class="col-sm-9"><%= professor.total_aulas %> (<%= professor.aulas_ativas %> ativa<%= professor.aulas_ativas === 1 ? '' : 's' %>)</dd>

            <dt class="col-sm-3">Criado em</dt>
            <dd class="col-sm-9"><%= formatadores.dataBr(professor.criado_em) %></dd>

            <dt class="col-sm-3">Última alteração</dt>
            <dd class="col-sm-9"><%= formatadores.dataBr(professor.atualizado_em) %></dd>
        </dl>
    </div>
<% } %>

<%- include('../../layouts/admin-fim') %>
