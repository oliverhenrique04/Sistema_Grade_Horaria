<%- include('../../layouts/admin-inicio') %>

<%
/*
 * Formulario de campus (criacao e edicao).
 * Reexibe sempre os valores digitados e as mensagens de erro por campo.
 */
%>

<section class="painel-cartao" aria-labelledby="titulo-formulario-campus">
    <div class="painel-cartao-cabecalho">
        <h2 class="h6 mb-0" id="titulo-formulario-campus">
            <%= edicao ? 'Editar campus' : 'Novo campus' %>
        </h2>
    </div>

    <% if (mensagemErro) { %>
        <div class="alert alert-danger" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2" aria-hidden="true"></i>
            <%= mensagemErro %>
        </div>
    <% } %>

    <form method="POST" action="<%= acao %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="row g-3">
            <div class="col-12 col-lg-7">
                <label class="form-label" for="campo-nome">Nome <span aria-hidden="true">*</span></label>
                <input type="text" class="form-control <%= erros.nome ? 'is-invalid' : '' %>"
                       id="campo-nome" name="nome" value="<%= valores.nome %>"
                       maxlength="120" required
                       <%= erros.nome ? 'aria-describedby="erro-nome" aria-invalid="true"' : '' %>>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'nome' }) %>
            </div>

            <div class="col-12 col-lg-5">
                <label class="form-label" for="campo-sigla">Sigla</label>
                <input type="text" class="form-control <%= erros.sigla ? 'is-invalid' : '' %>"
                       id="campo-sigla" name="sigla" value="<%= valores.sigla %>" maxlength="20"
                       <%= erros.sigla ? 'aria-describedby="erro-sigla" aria-invalid="true"' : '' %>>
                <div class="form-text">Opcional. Ex.: AC, AS.</div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'sigla' }) %>
            </div>

            <div class="col-12 col-lg-5">
                <label class="form-label" for="campo-ativo">Situação</label>
                <select class="form-select <%= erros.ativo ? 'is-invalid' : '' %>"
                        id="campo-ativo" name="ativo">
                    <option value="1" <%= valores.ativo ? 'selected' : '' %>>Ativo</option>
                    <option value="0" <%= valores.ativo ? '' : 'selected' %>>Inativo</option>
                </select>
                <div class="form-text">
                    Campus com turmas ativas não podem ser inativados.
                </div>
                <%- include('../../partials/campo-erro', { erros: erros, campo: 'ativo' }) %>
            </div>
        </div>

        <% if (edicao && (registro.total_locais > 0 || registro.total_turmas > 0)) { %>
            <p class="painel-indicador-nota mt-3 mb-0">
                Vínculos atuais: <%= registro.total_locais %> local(is) e
                <%= registro.total_turmas %> turma(s).
            </p>
        <% } %>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                <%= edicao ? 'Salvar alterações' : 'Cadastrar campus' %>
            </button>
            <a class="btn btn-outline-secondary" href="<%= voltarUrl %>">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../../layouts/admin-fim') %>
