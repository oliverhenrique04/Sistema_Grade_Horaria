<%- include('../../layouts/admin-inicio') %>

<%
/*
 * Lista de campus: busca por nome/sigla, filtro de situacao, contagem de locais
 * e turmas vinculados e acoes de manutencao.
 *
 * O <h1> da pagina fica na barra superior, por isso a secao comeca em <h2>.
 */
%>

<section class="painel-cartao" aria-labelledby="titulo-campus">
    <div class="painel-cartao-cabecalho">
        <div>
            <h2 class="h6 mb-1" id="titulo-campus">Campus cadastrados</h2>
            <p class="painel-indicador-nota mb-0">
                Campus com turmas ativas não podem ser inativados.
            </p>
        </div>

        <% if (podeVer('campus', 'criar')) { %>
            <a class="btn btn-primary btn-sm" href="<%= withBase('/admin/campus/novo') %>">
                <i class="fa-solid fa-plus" aria-hidden="true"></i> Novo campus
            </a>
        <% } %>
    </div>

    <form method="GET" action="<%= withBase('/admin/campus') %>" class="painel-filtros" role="search">
        <div class="painel-filtros-campo">
            <label class="form-label" for="filtro-busca">Buscar</label>
            <input type="search" class="form-control form-control-sm" id="filtro-busca"
                   name="busca" value="<%= filtros.busca %>" placeholder="Nome ou sigla"
                   maxlength="120">
        </div>

        <div class="painel-filtros-campo">
            <label class="form-label" for="filtro-situacao">Situação</label>
            <select class="form-select form-select-sm" id="filtro-situacao" name="ativo"
                    data-submete-ao-mudar>
                <option value="" <%= filtros.ativo === '' ? 'selected' : '' %>>Todos</option>
                <option value="1" <%= filtros.ativo === '1' ? 'selected' : '' %>>Ativos</option>
                <option value="0" <%= filtros.ativo === '0' ? 'selected' : '' %>>Inativos</option>
            </select>
        </div>

        <div class="painel-filtros-campo">
            <label class="form-label" for="filtro-por-pagina">Por página</label>
            <select class="form-select form-select-sm" id="filtro-por-pagina" name="por_pagina"
                    data-submete-ao-mudar>
                <% paginacao.tamanhos.forEach((tamanho) => { %>
                    <option value="<%= tamanho %>" <%= paginacao.porPagina === tamanho ? 'selected' : '' %>>
                        <%= tamanho %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div>
            <button type="submit" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Filtrar
            </button>
            <a class="btn btn-sm btn-link" href="<%= withBase('/admin/campus') %>">Limpar</a>
        </div>
    </form>

    <% if (itens.length === 0) { %>
        <%- include('../../partials/estado-vazio', {
            icone: 'fa-building-columns',
            titulo: 'Nenhum campus encontrado',
            descricao: filtros.busca || filtros.ativo !== ''
                ? 'Nenhum campus corresponde aos filtros aplicados.'
                : 'Cadastre o primeiro campus da instituição.',
            acaoUrl: podeVer('campus', 'criar') ? withBase('/admin/campus/novo') : null,
            acaoTexto: 'Novo campus'
        }) %>
    <% } else { %>
        <div class="table-responsive">
            <table class="table painel-tabela align-middle">
                <thead>
                    <tr>
                        <th scope="col">Campus</th>
                        <th scope="col">Sigla</th>
                        <th scope="col" class="text-end">Locais</th>
                        <th scope="col" class="text-end">Turmas</th>
                        <th scope="col">Situação</th>
                        <th scope="col"><span class="visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    <% itens.forEach((item) => { %>
                        <% const semVinculos = item.total_locais === 0 && item.total_turmas === 0; %>
                        <tr>
                            <th scope="row" class="fw-semibold"><%= item.nome %></th>
                            <td><%= item.sigla || '—' %></td>
                            <td class="text-end">
                                <% if (item.total_locais > 0 && podeVer('locais')) { %>
                                    <a href="<%= withBase('/admin/locais?campus_id=' + item.id) %>">
                                        <%= item.total_locais %>
                                    </a>
                                <% } else { %>
                                    <%= item.total_locais %>
                                <% } %>
                            </td>
                            <td class="text-end">
                                <%= item.total_turmas %>
                                <% if (item.total_turmas_ativas > 0) { %>
                                    <span class="painel-indicador-nota">
                                        (<%= item.total_turmas_ativas %> ativa<%= item.total_turmas_ativas === 1 ? '' : 's' %>)
                                    </span>
                                <% } %>
                            </td>
                            <td><%- include('../../partials/status-badge', { ativo: item.ativo }) %></td>
                            <td>
                                <div class="painel-tabela-acoes">
                                    <% if (podeVer('campus', 'editar')) { %>
                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="<%= withBase('/admin/campus/' + item.id + '/editar') %>">
                                            <i class="fa-solid fa-pen" aria-hidden="true"></i>
                                            <span class="visually-hidden">Editar <%= item.nome %></span>
                                        </a>
                                    <% } %>

                                    <% if (podeVer('campus', 'inativar')) { %>
                                        <form method="POST"
                                              action="<%= withBase('/admin/campus/' + item.id + '/situacao') %>"
                                              data-confirmar="<%= item.ativo ? 'Inativar o campus ' + item.nome + '?' : 'Reativar o campus ' + item.nome + '?' %>">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="ativo" value="<%= item.ativo ? '0' : '1' %>">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                <i class="fa-solid <%= item.ativo ? 'fa-toggle-off' : 'fa-toggle-on' %>" aria-hidden="true"></i>
                                                <span class="visually-hidden">
                                                    <%= item.ativo ? 'Inativar' : 'Reativar' %> <%= item.nome %>
                                                </span>
                                            </button>
                                        </form>

                                        <% if (semVinculos) { %>
                                            <form method="POST"
                                                  action="<%= withBase('/admin/campus/' + item.id + '/excluir') %>"
                                                  data-confirmar="Excluir definitivamente o campus <%= item.nome %>? Esta ação não pode ser desfeita.">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                    <span class="visually-hidden">Excluir <%= item.nome %></span>
                                                </button>
                                            </form>
                                        <% } %>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <%- include('../../partials/paginacao', { paginacao: paginacao, urlBase: urlBase }) %>
    <% } %>
</section>

<%- include('../../layouts/admin-fim') %>
